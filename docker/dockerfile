# FoundationPose, model-based inference and the drpose evaluation.
#
# What was wrong with the original image, and what changed:
#   * nvidia/cudagl:11.3 is frozen since 2022 and too old for recent GPUs (see readme, issue #27).
#     CUDA 12.8 covers Turing through Blackwell.
#   * `conda update -c defaults` now stops at a Terms of Service prompt in a non-interactive build.
#     Ubuntu 22.04 ships Python 3.10, so conda is not needed at all.
#   * pytorch3d and nvdiffrast failed under pip's build isolation, which hides torch from them.
#     nvdiffrast now uses --no-build-isolation.
#   * pytorch3d, Boost, pybind11 and the mycpp build are gone: compat_windows.py replaces the three
#     functions inference used, and tests/test_compat_windows.py checks them against the originals.
#   * kaolin is gone too. Only the model-free path needs it. The unpinned `git clone` broke builds.
#   * Packages unrelated to inference (wandb, objaverse, g4f, ultralytics, ...) are removed.
#
# Build:  docker build -t foundationpose -f docker/dockerfile .
# Run:    bash docker/run_container.sh   (from the docker/ folder)
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0;12.0" \
    OPENCV_IO_ENABLE_OPENEXR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10 python3.10-dev python3-pip python-is-python3 \
      git ca-certificates build-essential ninja-build \
      libgl1 libegl1 libglib2.0-0 libgomp1 libx11-6 libxext6 libsm6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip wheel "setuptools<81"

RUN python -m pip install torch==2.9.1+cu128 torchvision==0.24.1+cu128 \
      --index-url https://download.pytorch.org/whl/cu128

COPY requirements-lock.txt /tmp/requirements-lock.txt
RUN python -m pip install -r /tmp/requirements-lock.txt

# No GPU is visible during `docker build`, which is why TORCH_CUDA_ARCH_LIST is set above.
RUN git clone --depth 1 --branch v0.4.0 https://github.com/NVlabs/nvdiffrast /opt/nvdiffrast \
    && python -m pip install --no-build-isolation --no-deps /opt/nvdiffrast

RUN git clone https://github.com/thodan/bop_toolkit /opt/bop_toolkit \
    && git -C /opt/bop_toolkit checkout cea62d6

ENV PYTHONPATH=/opt/bop_toolkit
ENV SHELL=/bin/bash
WORKDIR /workspace
